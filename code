                // Init method
                init() {
                    lucide.createIcons();
                },

                // Filtered Photos Computed Logic
                get filteredPhotos() {
                    return this.photos.filter(photo => {
                        // Category Filter
                        const matchesCategory = this.activeCategory === 'All' || photo.category === this.activeCategory;
                        
                        // Search Query Filter
                        const query = this.searchQuery.toLowerCase();
                        const matchesSearch = !query || 
                            photo.title.toLowerCase().includes(query) ||
                            photo.aircraft.toLowerCase().includes(query) ||
                            photo.registration.toLowerCase().includes(query) ||
                            photo.location.toLowerCase().includes(query) ||
                            photo.category.toLowerCase().includes(query);

                        // Favorite Filter
                        const matchesFav = !this.showFavoritesOnly || this.isFavorite(photo.id);

                        return matchesCategory && matchesSearch && matchesFav;
                    });
                },

                // Filtered Spotting Logs
                get filteredSpottingLogs() {
                    if (this.logFilter === 'all') return this.spottingLogs;
                    return this.spottingLogs.filter(log => log.status.toLowerCase() === this.logFilter);
                },

                // Category Count Helper
                getCategoryCount(category) {
                    if (category === 'All') return this.photos.length;
                    return this.photos.filter(p => p.category === category).length;
                },

                // Favorite Toggle Logic
                toggleFavorite(id) {
                    if (this.favorites.includes(id)) {
                        this.favorites = this.favorites.filter(favId => favId !== id);
                        this.triggerToast('Removed from Bookmarks');
                    } else {
                        this.favorites.push(id);
                        this.triggerToast('Saved to Bookmarks');
                    }
                    localStorage.setItem('av_favorites', JSON.stringify(this.favorites));
                },

                isFavorite(id) {
                    return this.favorites.includes(id);
                },

                // Lightbox Open
                openLightbox(photo) {
                    this.selectedPhoto = photo;
                    this.$nextTick(() => lucide.createIcons());
                },

                // Open Print For Specific Photo
                openPrintForPhoto(photo) {
                    this.selectedPrintPhotoId = photo.id;
                    const printsSec = document.getElementById('prints');
                    if (printsSec) {
                        printsSec.scrollIntoView({ behavior: 'smooth' });
                    }
                    this.triggerToast(`Selected "${photo.aircraft}" for Print`);
                },

                // Reset Filters
                resetFilters() {
                    this.searchQuery = '';
                    this.activeCategory = 'All';
                    this.showFavoritesOnly = false;
                },

                // Live Dynamic Price Calculation
                get calculatedPrice() {
                    const sizeObj = this.sizes.find(s => s.id === this.selectedSize) || this.sizes[0];
                    const matObj = this.materials.find(m => m.id === this.selectedMaterial) || this.materials[0];
                    return sizeObj.basePrice + matObj.extraCost;
                },

                // Print Inquiry Submission
                submitInquiry() {
                    const currentPhoto = this.photos.find(p => p.id === this.selectedPrintPhotoId);
                    this.triggerToast(`Print Request Created for ${currentPhoto?.aircraft} ($${this.calculatedPrice})`);
                },

                // Copy Share Link
                copyShareLink(photo) {
                    const tempInput = document.createElement('input');
                    tempInput.value = window.location.href;
                    document.body.appendChild(tempInput);
                    tempInput.select();
                    document.execCommand('copy');
                    document.body.removeChild(tempInput);
                    this.triggerToast('Photo Link Copied to Clipboard!');
                },

                // Toast Notification Trigger
                triggerToast(msg) {
                    this.toastMessage = msg;
                    this.showToast = true;
                    setTimeout(() => {
                        this.showToast = false;
                    }, 3000);
                }
            }
