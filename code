<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VAPOR STRIKE // Aviation Photography & Spotting Portfolio</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Alpine.js CDN for reactive state -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind Config Customizations -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        hud: {
                            cyan: '#06b6d4',
                            amber: '#f59e0b',
                            green: '#10b981',
                            dark: '#090d16',
                            card: '#0f172a'
                        }
                    },
                    animation: {
                        'radar-sweep': 'radarSweep 4s linear infinite',
                        'pulse-glow': 'pulseGlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        radarSweep: {
                            '0%': { transform: 'rotate(0deg)' },
                            '100%': { transform: 'rotate(360deg)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { opacity: '1', filter: 'drop-shadow(0 0 8px rgba(6, 182, 212, 0.6))' },
                            '50%': { opacity: '0.5', filter: 'drop-shadow(0 0 2px rgba(6, 182, 212, 0.2))' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom HUD grid lines & scrollbar */
        body {
            background-color: #030712;
            color: #f3f4f6;
        }
        .bg-hud-grid {
            background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .scanline-overlay {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.25) 50%
            );
            background-size: 100% 4px;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #06b6d4;
        }
    </style>
</head>

<body x-data="aviationApp()" x-init="init()" class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cyan-500 selection:text-slate-950 min-h-screen flex flex-col">

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-40 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- Branding / Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="relative w-10 h-10 rounded-lg bg-slate-900 border border-cyan-500/40 flex items-center justify-center text-cyan-400 group-hover:border-cyan-400 transition-colors shadow-lg shadow-cyan-950/50">
                    <i data-lucide="plane" class="w-5 h-5 transform -rotate-45 group-hover:scale-110 transition-transform"></i>
                    <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-cyan-400 rounded-full animate-ping"></span>
                    <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-cyan-400 rounded-full"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-mono font-bold tracking-wider text-lg text-white">VAPOR<span class="text-cyan-400">STRIKE</span></span>
                        <span class="text-[10px] font-mono bg-cyan-950 text-cyan-400 border border-cyan-800/50 px-1.5 py-0.5 rounded uppercase">HQ</span>
                    </div>
                    <p class="text-xs text-slate-400 font-mono">AV-PHOTO // TACTICAL ARCHIVE</p>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center gap-8 font-mono text-sm">
                <a href="#gallery" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="aperture" class="w-4 h-4 text-cyan-400"></i> Gallery
                </a>
                <a href="#spotting-log" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="radar" class="w-4 h-4 text-cyan-400"></i> Spotting Log
                </a>
                <a href="#gear" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="camera" class="w-4 h-4 text-cyan-400"></i> Spotter Gear
                </a>
                <a href="#prints" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="shopping-bag" class="w-4 h-4 text-cyan-400"></i> Prints & Licensing
                </a>
                <a href="#about" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="user" class="w-4 h-4 text-cyan-400"></i> Bio & Stats
                </a>
            </nav>

            <!-- Actions & Bookmarks Counter -->
            <div class="flex items-center gap-4">
                <button 
                    @click="showFavoritesOnly = !showFavoritesOnly; if(showFavoritesOnly){ $nextTick(() => document.getElementById('gallery').scrollIntoView({behavior: 'smooth'})); }" 
                    class="relative p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 hover:text-amber-400 transition-colors"
                    :class="{ 'border-amber-500/50 text-amber-400 bg-amber-950/20': showFavoritesOnly }"
                    title="View Saved / Favorites">
                    <i data-lucide="bookmark" class="w-5 h-5"></i>
                    <span 
                        x-show="favorites.length > 0" 
                        x-text="favorites.length" 
                        class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-amber-500 text-slate-950 font-mono font-bold text-xs rounded-full flex items-center justify-center shadow">
                    </span>
                </button>

                <a href="#prints" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider transition-all transform active:scale-95 shadow-lg shadow-cyan-500/20">
                    <i data-lucide="printer" class="w-4 h-4"></i> Get Prints
                </a>

                <!-- Mobile Menu Button -->
                <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
                    <i data-lucide="menu" x-show="!mobileMenuOpen" class="w-6 h-6"></i>
                    <i data-lucide="x" x-show="mobileMenuOpen" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div x-show="mobileMenuOpen" x-transition class="md:hidden border-b border-slate-800 bg-slate-950/95 px-4 pt-2 pb-6 space-y-3 font-mono text-sm">
            <a href="#gallery" @click="mobileMenuOpen = false" class="block py-2 text-slate-300 hover:text-cyan-400">01. Photo Gallery</a>
            <a href="#spotting-log" @click="mobileMenuOpen = false" class="block py-2 text-slate-300 hover:text-cyan-400">02. Airshow Log</a>
            <a href="#gear" @click="mobileMenuOpen = false" class="block py-2 text-slate-300 hover:text-cyan-400">03. Spotter Gear Bag</a>
            <a href="#prints" @click="mobileMenuOpen = false" class="block py-2 text-slate-300 hover:text-cyan-400">04. Print Quote Builder</a>
            <a href="#about" @click="mobileMenuOpen = false" class="block py-2 text-slate-300 hover:text-cyan-400">05. About & Stats</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-hud-grid border-b border-slate-800/80">
        <!-- Background Dark Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-transparent to-slate-950/90 z-10"></div>
        
        <!-- Radar Visual Sweep Animation -->
        <div class="absolute w-[600px] h-[600px] rounded-full border border-cyan-500/10 pointer-events-none top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-0 hidden lg:block">
            <div class="absolute inset-0 rounded-full border border-cyan-500/5 scale-75"></div>
            <div class="absolute inset-0 rounded-full border border-cyan-500/5 scale-50"></div>
            <div class="w-full h-full rounded-full animate-radar-sweep bg-[conic-gradient(from_0deg,transparent_0_300deg,rgba(6,182,212,0.15)_360deg)]"></div>
        </div>

        <!-- Jet Visual Backdrop (Unsplash Image with subtle contrast) -->
        <div class="absolute inset-0 opacity-25 mix-blend-luminosity bg-cover bg-center filter grayscale brightness-75 scale-105" style="background-image: url('https://images.unsplash.com/photo-1519074069444-1ba4ed16be48?auto=format&fit=crop&w=2000&q=80')"></div>

        <!-- Hero Content HUD -->
        <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
            
            <!-- Badge / Status Bar -->
            <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-slate-900/90 border border-cyan-500/30 text-cyan-400 font-mono text-xs mb-8 shadow-xl backdrop-blur-md">
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                </span>
                <span>SYSTEM ONLINE // 8K TELEMETRY READY</span>
                <span class="text-slate-600">|</span>
                <span class="text-slate-400">LOC: RAF CONINGSBY / EGXC</span>
            </div>

            <!-- Main Heading -->
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white uppercase mb-6 font-sans">
                CAPTURING THE POWER OF <br class="hidden sm:inline"/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-200 to-emerald-400">
                    THUNDER & SPEED
                </span>
            </h1>

            <p class="max-w-2xl mx-auto text-slate-400 text-base sm:text-lg mb-10 font-sans leading-relaxed">
                High-speed aviation photography, military intercept spotter logs, and fine-art aircraft prints captured at airshows and low-altitude passes worldwide.
            </p>

            <!-- Hero Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-4 font-mono text-sm">
                <a href="#gallery" class="px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold uppercase tracking-wider transition-all transform hover:-translate-y-0.5 shadow-lg shadow-cyan-500/25 flex items-center gap-2">
                    <i data-lucide="eye" class="w-4 h-4"></i> Explore Gallery
                </a>
                <a href="#prints" class="px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 hover:border-slate-600 font-semibold transition-all flex items-center gap-2">
                    <i data-lucide="calculator" class="w-4 h-4 text-cyan-400"></i> Instant Print Calculator
                </a>
            </div>

            <!-- Telemetry Stats Bar -->
            <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-md max-w-4xl mx-auto font-mono text-left">
                <div class="p-3 border-r border-slate-800/80 last:border-r-0">
                    <p class="text-xs text-slate-500 uppercase">AIRCRAFT SPOTTED</p>
                    <p class="text-2xl font-bold text-white mt-1">1,480<span class="text-cyan-400 text-sm">+</span></p>
                </div>
                <div class="p-3 border-r border-slate-800/80 last:border-r-0">
                    <p class="text-xs text-slate-500 uppercase">MAX SHUTTER SPEED</p>
                    <p class="text-2xl font-bold text-white mt-1">1/8000<span class="text-cyan-400 text-xs">s</span></p>
                </div>
                <div class="p-3 border-r border-slate-800/80 last:border-r-0">
                    <p class="text-xs text-slate-500 uppercase">AIRSHOWS LOGGED</p>
                    <p class="text-2xl font-bold text-white mt-1">64</p>
                </div>
                <div class="p-3">
                    <p class="text-xs text-slate-500 uppercase">LONGEST TELEPHOTO</p>
                    <p class="text-2xl font-bold text-white mt-1">600<span class="text-cyan-400 text-xs">mm f/4</span></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Photo Gallery Section -->
    <section id="gallery" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex-1">
        
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
            <div>
                <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs uppercase tracking-widest mb-2">
                    <i data-lucide="crosshair" class="w-4 h-4"></i> Operational Archive
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Interactive Photo Gallery</h2>
            </div>
            
            <p class="text-slate-400 text-sm max-w-md">
                Filter by aircraft category or search by tail number, location, or equipment specs. Click any image for full camera EXIF telemetry.
            </p>
        </div>

        <!-- Filter Controls Bar -->
        <div class="bg-slate-900/90 border border-slate-800 p-4 rounded-2xl mb-8 space-y-4 backdrop-blur-md">
            
            <!-- Category Tabs -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none text-xs font-mono">
                <template x-for="cat in categories" :key="cat">
                    <button 
                        @click="activeCategory = cat; showFavoritesOnly = false"
                        class="px-4 py-2 rounded-xl whitespace-nowrap transition-all border font-medium flex items-center gap-2"
                        :class="activeCategory === cat && !showFavoritesOnly 
                            ? 'bg-cyan-500 text-slate-950 border-cyan-400 shadow-md font-bold' 
                            : 'bg-slate-950/60 text-slate-400 border-slate-800 hover:border-slate-700 hover:text-white'">
                        <span x-text="cat"></span>
                        <span class="px-1.5 py-0.5 rounded-md text-[10px]" 
                              :class="activeCategory === cat && !showFavoritesOnly ? 'bg-slate-950/20 text-slate-950' : 'bg-slate-800 text-slate-400'"
                              x-text="getCategoryCount(cat)"></span>
                    </button>
                </template>
            </div>

            <!-- Search, View Mode & Favorites Toggle Bar -->
            <div class="flex flex-col sm:flex-row items-center gap-4 pt-2 border-t border-slate-800/80">
                
                <!-- Search Input -->
                <div class="relative w-full sm:w-80">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                    <input 
                        type="text" 
                        x-model="searchQuery" 
                        placeholder="Search aircraft, location, tag (e.g. F-22, Concorde)..." 
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-10 pr-4 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition-colors font-mono">
                    <button x-show="searchQuery" @click="searchQuery = ''" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white text-xs">
                        ✕
                    </button>
                </div>

                <div class="flex items-center justify-between sm:justify-end w-full gap-3">
                    <!-- Favorites Filter Indicator -->
                    <button 
                        @click="showFavoritesOnly = !showFavoritesOnly" 
                        class="px-3 py-2 rounded-xl border text-xs font-mono flex items-center gap-2 transition-colors"
                        :class="showFavoritesOnly ? 'bg-amber-500/20 border-amber-500/50 text-amber-400' : 'bg-slate-950 border-slate-800 text-slate-400 hover:text-white'">
                        <i data-lucide="bookmark" class="w-4 h-4"></i>
                        <span>Favorites Only (<span x-text="favorites.length"></span>)</span>
                    </button>

                    <!-- View Switcher (Grid vs Masonry) -->
                    <div class="flex items-center bg-slate-950 border border-slate-800 rounded-xl p-1">
                        <button 
                            @click="viewMode = 'grid'" 
                            class="p-1.5 rounded-lg transition-colors"
                            :class="viewMode === 'grid' ? 'bg-slate-800 text-cyan-400' : 'text-slate-500 hover:text-slate-300'"
                            title="Grid View">
                            <i data-lucide="grid" class="w-4 h-4"></i>
                        </button>
                        <button 
                            @click="viewMode = 'masonry'" 
                            class="p-1.5 rounded-lg transition-colors"
                            :class="viewMode === 'masonry' ? 'bg-slate-800 text-cyan-400' : 'text-slate-500 hover:text-slate-300'"
                            title="Masonry Layout View">
                            <i data-lucide="layout-grid" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gallery Grid -->
        <div 
            :class="{
                'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6': viewMode === 'grid',
                'columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6': viewMode === 'masonry'
            }">
            
            <template x-for="photo in filteredPhotos" :key="photo.id">
                <div 
                    class="group relative bg-slate-900 rounded-2xl overflow-hidden border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-950/40 transform hover:-translate-y-1"
                    :class="viewMode === 'masonry' ? 'break-inside-avoid mb-6' : ''">
                    
                    <!-- Image Container -->
                    <div class="relative overflow-hidden cursor-pointer" @click="openLightbox(photo)">
                        <img 
                            :src="photo.imageUrl" 
                            :alt="photo.title"
                            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                            :class="viewMode === 'masonry' ? 'h-auto max-h-[500px]' : 'h-64'">
                        
                        <!-- Hover Overlay Gradient -->
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-4">
                            
                            <!-- Top Overlay Bar -->
                            <div class="flex items-center justify-between">
                                <span class="bg-slate-950/80 backdrop-blur border border-slate-800 text-cyan-400 font-mono text-[11px] px-2.5 py-1 rounded-md" x-text="photo.registration"></span>
                                <span class="bg-slate-950/80 backdrop-blur text-slate-300 font-mono text-[11px] px-2.5 py-1 rounded-md" x-text="photo.exif.focalLength"></span>
                            </div>

                            <!-- Bottom Quick Telemetry -->
                            <div>
                                <p class="text-xs font-mono text-cyan-400 mb-0.5" x-text="photo.location"></p>
                                <p class="text-sm font-bold text-white" x-text="photo.aircraft"></p>
                                <div class="mt-2 text-[11px] font-mono text-slate-300 flex items-center gap-3">
                                    <span>⚡ <span x-text="photo.exif.shutter"></span></span>
                                    <span>ƒ/ <span x-text="photo.exif.aperture"></span></span>
                                    <span>ISO <span x-text="photo.exif.iso"></span></span>
                                </div>
                            </div>
                        </div>

                        <!-- Tag Badge Top Left -->
                        <div class="absolute top-3 left-3 bg-slate-950/75 backdrop-blur-md px-2.5 py-1 rounded-lg border border-slate-800 text-[11px] font-mono text-slate-300">
                            <span x-text="photo.category"></span>
                        </div>
                    </div>

                    <!-- Card Footer Actions -->
                    <div class="p-4 bg-slate-900 border-t border-slate-800/60 flex items-center justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-slate-200 line-clamp-1" x-text="photo.title"></h3>
                            <p class="text-xs text-slate-500 font-mono mt-0.5" x-text="photo.date"></p>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <!-- Favorite Toggle Button -->
                            <button 
                                @click.stop="toggleFavorite(photo.id)" 
                                class="p-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-400 hover:text-amber-400 transition-colors"
                                :class="isFavorite(photo.id) ? 'text-amber-400 border-amber-500/40 bg-amber-950/30' : ''"
                                title="Bookmark Photo">
                                <i data-lucide="bookmark" class="w-4 h-4"></i>
                            </button>

                            <!-- Print Inquiry Direct Button -->
                            <button 
                                @click.stop="openPrintForPhoto(photo)" 
                                class="p-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-400 hover:text-cyan-400 transition-colors"
                                title="Order Print of this Aircraft">
                                <i data-lucide="printer" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </template>
        </div>

        <!-- Empty State -->
        <div x-show="filteredPhotos.length === 0" class="text-center py-20 bg-slate-900/40 rounded-2xl border border-slate-800 my-8">
            <i data-lucide="radar" class="w-12 h-12 text-slate-600 mx-auto mb-4 animate-spin"></i>
            <h3 class="text-lg font-bold text-white font-mono">NO TARGETS DETECTED</h3>
            <p class="text-slate-400 text-sm mt-1 max-w-sm mx-auto">No photos match your current search query or filter tags. Try clearing search filters.</p>
            <button @click="resetFilters()" class="mt-4 px-4 py-2 rounded-xl bg-slate-800 text-slate-200 font-mono text-xs hover:bg-slate-700">
                Reset All Filters
            </button>
        </div>
    </section>

    <!-- Lightbox Modal with Full EXIF Telemetry Overlay -->
    <div 
        x-show="selectedPhoto" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-slate-950/95 backdrop-blur-xl overflow-y-auto"
        style="display: none;">
        
        <div class="relative w-full max-w-6xl bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl flex flex-col lg:flex-row my-auto">
            
            <!-- Close Modal Button -->
            <button @click="selectedPhoto = null" class="absolute top-4 right-4 z-20 p-2.5 rounded-full bg-slate-950/80 border border-slate-800 text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <!-- Lightbox Main Image Display -->
